---
import Divider from "./Divider.astro";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <span>Cuidando tus </span>Mascotas que te cuidan a ti.
    </div>
    <Divider inverted={true} />

    <div class="footer-bottom">
      <div class="footer-copyright">
        © {year} Todos los derechos reservados. Powered by
        <a
          href="https://revolutionti.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover-link"
        >
          RevolutionTi
        </a>.
      </div>

      <div class="footer-social">
        <a
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="link-text">Instagram</a
        >
        <a
          href="https://www.linkedin.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="link-text">LinkedIn</a
        >
        <a
          href="https://www.facebook.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="link-text">Facebook</a
        >
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-secondary);
  }

  .container {
    padding: 6rem 1rem;
    font-size: 1.2rem;
    color: var(--color-secondary);
    background: var(--color-primary);
    border-radius: 50px 50px 0 0;
    margin: 0 auto;
  }

  .footer-content {
    margin: 0 auto 5rem;
    max-width: 1400px;
    font-weight: 800;
    font-size: 8rem;
    line-height: 6rem;
    transform: translateY(15px);
  }

  .footer-content span {
    font-family: "Alegreya", serif;
    font-style: italic;
    font-size: 5rem;
    transform: translateY(15px);
  }

  .footer-bottom {
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    margin: 2rem auto;
  }

  .footer-copyright {
    text-align: center;
  }

  .footer-social {
    display: flex;
    gap: 1.5rem;
  }

  .link-text,
  .hover-link {
    color: var(--footer-link);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link-text:hover,
  .hover-link:hover {
    color: var(--footer-link-hover);
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 1rem 2rem;
    }

    .footer-content {
      margin: 0 auto 1rem;
      font-size: 2rem;
      line-height: 2rem;
    }

    .footer-content span {
      font-size: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
    }
    .footer-copyright {
      text-align: center;
    }
    .footer-social {
      display: flex;
      gap: 1.5rem;
    }
  }
</style>
