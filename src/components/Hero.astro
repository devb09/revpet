<section class="hero">
  <div class="hero__container">
    <div class="hero__text-container">
      <div class="hero__title">
        <div class="hero__title--line">
          <h1 class="hero__split-text--char">Cuidando</h1><span
            class="hero__split-text--word">tus</span
          >
        </div>
        <h1 class="hero__split-text--char">Mascotas</h1>
      </div>

      <div class="hero__images">
        <div class="hero__image-wrapper hero__image-wrapper--1">
          <img
            class="hero__image"
            src="/images/vet-cat.webp"
            alt="Hero image 1"
          />
        </div>
        <div class="hero__image-wrapper hero__image-wrapper--2">
          <img
            class="hero__image"
            src="/images/vet-dog.webp"
            alt="Hero image 2"
          />
        </div>
        <div class="hero__image-wrapper hero__image-wrapper--3">
          <img
            class="hero__image"
            src="/images/vet-bird.webp"
            alt="Hero image 3"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-secondary);
    /* overflow: hidden; */
  }

  .hero__container {
    background-color: var(--color-primary);
    color: var(--color-secondary);
    height: 210vh;
    border-radius: 0 0 50px 50px;
    position: relative;
  }

  .hero__text-container {
    top: 0;
    position: sticky;
    z-index: 2;
    height: 100dvh;
    display: flex;
    align-items: end;
    padding: 2rem 5rem 4rem;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    margin-bottom: 5rem;
    z-index: 2;
  }

  .hero__title--line {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hero__title h1 {
    display: flex;
    font-size: 10rem;
    font-weight: 900;
    margin: 0;
    line-height: 10rem;
  }

  .hero__title span {
    font-family: "Alegreya", serif;
    font-style: italic;
    font-size: 5rem;
    transform: translateY(15px);
  }

  .hero__image-wrapper {
    max-width: 300px;
    overflow: clip;
    border-radius: 24px;
    transform-origin: center;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__image-wrapper--1,
  .hero__image-wrapper--2,
  .hero__image-wrapper--3 {
    position: absolute;
  }

  .hero__image-wrapper--1 {
    inset: 10% auto auto 20%;
  }

  .hero__image-wrapper--2 {
    inset: 12% 5% auto auto;
  }

  .hero__image-wrapper--3 {
    inset: 60% auto auto 50%;
  }

  @media (max-width: 768px) {
    .hero__container {
      height: 180vh;
    }

    .hero__text-container {
      padding: 2rem 2rem 4rem;
    }

      .hero__title--line {
    gap: 5px;
  }

    .hero__title h1 {
      font-size: 3rem;
      line-height: 3rem;
    }

    .hero__title span {
      font-size: 3rem;
      transform: translateY(10px);
    }

    .hero__image-wrapper {
      max-width: 200px;
      border-radius: 16px;
    }

    .hero__image-wrapper--1 {
      inset: 10% auto auto 10%;
    }

    .hero__image-wrapper--2 {
      inset: 38% 5% auto auto;
    }

    .hero__image-wrapper--3 {
      inset: 65% auto auto 40%;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger);
  gsap.registerPlugin(SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    // Guardamos el scroll al cargar
    const initialScroll = window.scrollY || 0;
    const isMobile = window.innerWidth <= 768;

    // === Intro timeline (NO ScrollTrigger aquí) ===
    const loadTl = gsap.timeline({ defaults: { ease: "power3.out" } });

    const split = SplitText.create(".hero__split-text--char", {
      type: "chars,words",
    });

    gsap.from(split.chars, {
      y: 100,
      filter: "blur(10px)",
      opacity: 0,
      duration: 1.7,
      ease: "power4",
      stagger: 0.08,
    });

    gsap.from(".hero__split-text--word", {
      filter: "blur(10px)",
      opacity: 0,
      duration: 2,
      delay: 0.5,
      ease: "power4",
    });

    loadTl
      .fromTo(
        ".hero__image-wrapper--1",
        { x: 250, y: "200%", scale: 0.5, opacity: 0, rotation: 100 },
        { x: 0, y: 0, scale: 1, opacity: 1, rotation: -10, duration: 1.5 }
      )
      .fromTo(
        ".hero__image-wrapper--2",
        { y: "100%", scale: 1.5, opacity: 0, rotation: -55 },
        {
          y: 0,
          scale: 0.8,
          opacity: 1,
          rotation: 15,
          duration: 1.2,
          delay: 0.5,
        },
        "<"
      )
      .fromTo(
        ".hero__image-wrapper--3",
        { x: 0, scale: 1.2, opacity: 0 },
        { x: 0, scale: 0.8, opacity: 1, duration: 1, delay: 0.2 },
        "<"
      )
      .add(() => {
        // === Scroll animation ===
        const scrollTl = gsap.timeline({
          scrollTrigger: {
            trigger: ".hero",
            start: "top top",
            end: "bottom 80%",
            scrub: true,
            // markers: true,
            invalidateOnRefresh: true,
          },
          defaults: { ease: "none" },
        });

        scrollTl
          .to(
            ".hero__image-wrapper--1",
            { x: 100, scale: 0.6, rotation: -15 },
            0
          )
          .to(
            ".hero__image-wrapper--2",
            { x: -80, scale: 0.7, rotation: 10 },
            0
          )
          .to(".hero__image-wrapper--3", { x: isMobile ? -100 : 350 }, 0)
          .to(".hero__image-wrapper--3", { scale: 0.6 }, 0.5);

        // === Caso 1: estamos arriba (scroll=0) ===
        if (initialScroll === 0) {
          // nada más → se queda en el final de la intro
          return;
        }

        // === Caso 2: había scroll al recargar ===
        // forzar actualización de progreso
        ScrollTrigger.refresh(true);
        ScrollTrigger.update();

        // tomar progreso actual del scroll y animar suave hasta ahí
        const st = scrollTl.scrollTrigger;
        const targetProgress = st!.progress;

        gsap.fromTo(
          scrollTl,
          { progress: 0 }, // arranca en el final de la intro (equivalente a progreso 0 del scroll)
          {
            progress: targetProgress,
            duration: 1, // tiempo del catch-up
            ease: "power2.out",
          }
        );
      });
  });
</script>
