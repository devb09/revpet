---
import { Image } from "astro:assets";

const images = [
  {
    src: "https://www.hoyaragon.es/asset/thumbnail,1280,720,center,center/media/hoyaragon/images/2024/09/04/20240904094424232093.jpeg",
    alt: "Perro",
  },
  {
    src: "https://cdn.pixabay.com/photo/2017/02/15/12/12/cat-2068462_1280.jpg",
    alt: "Gato",
  },
  {
    src: "https://media.istockphoto.com/id/1469413445/es/foto/caballo-al-aire-libre-en-el-pasto.jpg?s=612x612&w=0&k=20&c=HETbA-LKCEJ2VJeeNdwAALYBiXtQ4jIGK1QMg7XWVfI=",
    alt: "Caballo",
  },
  {
    src: "https://www.tiendanimal.es/articulos/wp-content/uploads/2020/03/aga-1200x675.jpg",
    alt: "Cotorros",
  },
];
---

<div class="marquee">
  <div class="marquee-track">
    {
      images.map(({ src, alt }) => (
        <Image src={src} alt={alt} width={430} height={500} loading="lazy" />
      ))
    }
    {
      images.map(({ src, alt }) => (
        <Image src={src} alt={alt} width={430} height={500} loading="lazy" />
      ))
    }
  </div>
</div>

<style>
  .marquee {
    background-color: var(--color-secondary);
    overflow: hidden;
    position: relative;
    width: 100%;
    padding: 10rem 0;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scroll 30s linear infinite;
  }

  .marquee-track img {
    width: 430px;
    margin-right: 2rem;
    border-radius: 12px;
    object-fit: cover;
    animation: floatY 10s ease-in-out infinite;
  }

  .marquee-track img:nth-child(2n) {
    animation: floatYReverse 10s ease-in-out infinite;
  }

  /* scroll horizontal infinito */
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* movimiento arriba-abajo */
  @keyframes floatY {
    0% {
      transform: translateY(15px);
    }
    50% {
      transform: translateY(-15px);
    }
    100% {
      transform: translateY(15px);
    }
  }

  @keyframes floatYReverse {
    0% {
      transform: translateY(-15px);
    }
    50% {
      transform: translateY(15px);
    }
    100% {
      transform: translateY(-15px);
    }
  }
</style>
